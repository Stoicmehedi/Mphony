{
  "manifest_version": 3,
  "name": "Mphony",
  "version": "0.1.5",
  "description": "Type English by default. Type the trigger word (ami) and typing flips to live Bangla (Avro phonetic) in any text box. Ctrl+Space toggles.",
  "author": "Md Mehedi Hasan",
  "developer": { "name": "Md Mehedi Hasan" },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["avro-lib.js", "dict-bn.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mphony — Banglish to Bangla",
    "default_icon": {
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mphony@mehedi",
      "strict_min_version": "109.0"
    }
  }
}
